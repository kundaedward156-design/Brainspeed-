# Add these exact names in Expo EAS → Project → Environment variables
# (and locally in .env for development)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_LIPILA_MERCHANT_ID=
EXPO_PUBLIC_LIPILA_API_BASE=https://api.lipila.dev/api/v1

# ─── Server-only (Supabase Edge Function secrets — NEVER in the app) ───
# Set with: supabase secrets set LIPILA_API_KEY=lpk_xxx AT_API_KEY=xxx AT_USERNAME=sandbox
# LIPILA_API_KEY=          # from dashboard.lipila.dev (sandbox) or dashboard.lipila.io (live)
# LIPILA_API_BASE=https://api.lipila.dev/api/v1
# AT_USERNAME=sandbox      # Africa's Talking username (sandbox or production app name)
# AT_API_KEY=              # Africa's Talking API key
# ALLOW_DEBUG_OTP=true     # only for sandbox: returns OTP in response when AT not configured
# SUPABASE_SERVICE_ROLE_KEY=
