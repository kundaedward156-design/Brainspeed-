# Only PUBLIC values go in the app (EAS → Project → Environment variables, and a local .env).
# The anon key is safe to ship: Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Lipila, Africa's Talking and the service-role key are SECRETS.
# They never go here — see supabase/secrets.example.env and SETUP.md.
