# Copy to supabase/secrets.env, fill in, then run:
#   supabase secrets set --env-file supabase/secrets.env
# NEVER commit secrets.env and NEVER put these in the app or in EAS variables.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Lipila mobile money (live base URL is https://api.lipila.io/api/v1)
LIPILA_API_KEY=
LIPILA_API_BASE=https://api.lipila.dev/api/v1

# Africa's Talking SMS. AT_USERNAME is "sandbox" while testing, your app name in production.
AT_USERNAME=sandbox
AT_API_KEY=
# Optional: a sender ID approved for Zambia
AT_SENDER_ID=

# Shown ONCE when you create the Send SMS hook in the Supabase dashboard
SEND_SMS_HOOK_SECRET=v1,whsec_replace_me

# Any long random string; paste the same value in the push webhook header
PUSH_WEBHOOK_SECRET=
